{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubernaut.ai/schemas/a2a/investigation_summary.v1.schema.json",
  "title": "Investigation Summary",
  "description": "Structured investigation summary emitted as A2A artifact DataPart",
  "type": "object",
  "required": ["session_id", "summary", "rca"],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "rr_id": {
      "type": "string"
    },
    "cluster_id": {
      "type": "string",
      "description": "Fleet cluster identifier for the RemediationRequest, when applicable (ADR-065)."
    },
    "summary": {
      "type": "string"
    },
    "selected_workflow": {
      "$ref": "#/$defs/selected_workflow"
    },
    "selection_assessment": {
      "$ref": "#/$defs/selection_assessment"
    },
    "rca": {
      "type": "object",
      "required": ["explanation"],
      "properties": {
        "explanation": { "type": "string" },
        "severity": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "causal_chain": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target": { "type": "string" },
        "root_cause": { "type": "string" },
        "affected_components": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tool_calls_count": { "type": "integer" },
        "llm_turns": { "type": "integer" }
      },
      "additionalProperties": true
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workflow_id", "name"],
        "properties": {
          "workflow_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "risk": { "type": "string" },
          "recommended": { "type": "boolean" },
          "parameters": { "type": "object" },
          "ruled_out_reason": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "severity": { "type": "string" },
    "confidence": { "type": "number" },
    "searched_target": {
      "type": "object",
      "description": "The Kubernetes resource that was searched against the workflow catalog. May differ from signal_target when RCA identifies a different root cause resource (#1437).",
      "properties": {
        "api_version": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "namespace": { "type": "string" }
      },
      "required": ["kind", "name", "namespace"]
    },
    "signal_target": {
      "type": "object",
      "description": "The original Kubernetes resource from the alert signal, before any RCA target override (#1437).",
      "properties": {
        "api_version": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "namespace": { "type": "string" }
      },
      "required": ["kind", "name", "namespace"]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "\\S"
    },
    "reasoning_part": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "repeat_justification": {
      "type": "object",
      "required": ["evidence_basis", "prior_outcome_relevance", "expected_mechanism"],
      "properties": {
        "evidence_basis": { "$ref": "#/$defs/reasoning_part" },
        "prior_outcome_relevance": { "$ref": "#/$defs/reasoning_part" },
        "expected_mechanism": { "$ref": "#/$defs/reasoning_part" }
      },
      "additionalProperties": false
    },
    "repeat_justification_assessment": {
      "type": "object",
      "description": "Rejected reasoning may be incomplete. Invalid or oversized parts are omitted, never truncated.",
      "properties": {
        "evidence_basis": { "$ref": "#/$defs/reasoning_part" },
        "prior_outcome_relevance": { "$ref": "#/$defs/reasoning_part" },
        "expected_mechanism": { "$ref": "#/$defs/reasoning_part" }
      },
      "additionalProperties": false
    },
    "selection_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validation_outcome": {
      "type": "string",
      "enum": ["accepted", "rejected", "not_required"]
    },
    "handoff_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "selected_workflow": {
      "type": "object",
      "description": "Server-owned live selection context, not execution configuration or prior-attempt links (DD-KA-2496).",
      "required": ["workflow_id", "workflow_name"],
      "properties": {
        "workflow_id": { "$ref": "#/$defs/identity" },
        "workflow_name": { "$ref": "#/$defs/identity" },
        "workflow_selection_confidence": { "$ref": "#/$defs/selection_confidence" },
        "repeat_justification": { "$ref": "#/$defs/repeat_justification" },
        "repeat_justification_required": { "type": "boolean" },
        "prior_workflow_match": { "type": "boolean" },
        "repeat_validation_outcome": { "$ref": "#/$defs/validation_outcome" },
        "handoff_digest": { "$ref": "#/$defs/handoff_digest" }
      },
      "additionalProperties": false
    },
    "selection_assessment": {
      "type": "object",
      "description": "Server-owned non-executable rejected proposal; never carries a selected workflow_id (DD-KA-2496).",
      "required": ["proposed_workflow_id"],
      "properties": {
        "proposed_workflow_id": { "$ref": "#/$defs/identity" },
        "workflow_name": { "$ref": "#/$defs/identity" },
        "workflow_selection_confidence": { "$ref": "#/$defs/selection_confidence" },
        "repeat_justification": { "$ref": "#/$defs/repeat_justification_assessment" },
        "repeat_justification_required": { "type": "boolean" },
        "prior_workflow_match": { "type": "boolean" },
        "repeat_validation_outcome": { "$ref": "#/$defs/validation_outcome" },
        "handoff_digest": { "$ref": "#/$defs/handoff_digest" }
      },
      "additionalProperties": false
    }
  }
}
