{
  "realm": "kubernaut-fleet",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 3600,
  "ssoSessionMaxLifespan": 604800,
  "clients": [
    {
      "clientId": "kubernaut-fleet-read",
      "name": "Kubernaut Fleet Read (E2E, subject identity)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "e2e-fleet-secret",
      "attributes": {
        "access.token.lifespan": "604800",
        "client.session.max.lifespan": "604800"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "kube-mcp-server-audience"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "kube-mcp-server",
      "name": "kube-mcp-server (E2E, token-exchange requester)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "e2e-kube-mcp-server-secret",
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "k8s-api-audience"
      ]
    },
    {
      "clientId": "k8s-api",
      "name": "Kubernetes API server (E2E, token-exchange target audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "kubernaut-console",
      "name": "Kubernaut Console (manual setup-e2e-fleet-infra, browser OIDC login)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "e2e-console-secret",
      "redirectUris": [
        "https://kubernaut-console.local:8843/oauth2/callback"
      ],
      "webOrigins": [
        "https://kubernaut-console.local:8843"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins",
        "groups",
        "kubernaut-apifrontend-audience"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile. Explicit here since hand-authored realm imports don't auto-seed Keycloak's standard scopes (see keycloak-realm-fleet.json file comment).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email. Explicit here since hand-authored realm imports don't auto-seed Keycloak's standard scopes.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "OpenID Connect built-in scope: roles. Explicit here since hand-authored realm imports don't auto-seed Keycloak's standard scopes.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "web-origins",
      "description": "OpenID Connect built-in scope: web-origins. Explicit here since hand-authored realm imports don't auto-seed Keycloak's standard scopes.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "consentRequired": false,
          "config": {}
        }
      ]
    },
    {
      "name": "kubernaut-apifrontend-audience",
      "description": "Adds the kubernaut-apifrontend aud claim required by AF's JWTValidator.validateAudience (matches kubernaut-operator's default). kubernaut-console default scope: Console's oauth2-proxy is this realm's only browser caller of AF.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "kubernaut-apifrontend-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "kubernaut-apifrontend",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "kube-mcp-server-audience",
      "description": "Authorizes kube-mcp-server to present this client's tokens for RFC 8693 token exchange (audience gate, validated empirically in Spike S18: removing this scope reinstates Keycloak's access_denied 'Client is not within the token audience').",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "kube-mcp-server-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "kube-mcp-server",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "k8s-api-audience",
      "description": "Scopes kube-mcp-server's exchanged tokens to k8s-api; also carries a preferred_username mapper the API server's OIDC authenticator requires (see keycloak_e2e.go).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "k8s-api-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "k8s-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "k8s-api-preferred-username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "groups",
      "description": "Maps group memberships into a \"groups\" claim (kubernaut-console client), matching APIFrontend's default JWT claim mapping and consoleAccessGroups keys.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups-membership-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "sre",
      "path": "/sre"
    }
  ],
  "users": [
    {
      "username": "sre-user",
      "enabled": true,
      "email": "sre-user@kubernaut.ai",
      "emailVerified": true,
      "firstName": "SRE",
      "lastName": "Tester",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "groups": [
        "/sre"
      ]
    }
  ]
}
